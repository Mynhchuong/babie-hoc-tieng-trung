{
  "files.encoding": "utf8",
  "files.exclude": { "**/__pycache__": true, "**/.DS_Store": true },
  "search.exclude": { "dist/**": true, "node_modules/**": true },
  "files.associations": { "*.gs": "javascript", "*.txt": "plaintext" },
  "editor.wordWrap": "on",
  "[html]": { "editor.formatOnSave": false },
  "[powershell]": { "files.eol": "\r\n", "files.encoding": "utf8bom" },
  "[bat]": { "files.eol": "\r\n" },
  "[vbs]": { "files.eol": "\r\n" },
  "liveServer.settings.root": "/dist"
}
